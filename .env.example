# ==========================================
# PORTFOLIO BACKEND & EMAIL CONFIGURATION
# ==========================================

# Server Port
PORT=3000

# SMTP Email Settings (using emailjs package)
# For Gmail:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an "App Password": https://myaccount.google.com/apppasswords
# 3. Paste your email address and 16-character App Password below.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SSL=true

# Sender credentials (your email address & App Password)
EMAIL_USER=mairayounus90@gmail.com
EMAIL_PASSWORD=Maira@123

# The destination address where contact messages should arrive
EMAIL_TO=mairayounus90@gmail.com
